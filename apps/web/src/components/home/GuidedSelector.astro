---
// GuidedSelector.astro
---

<section class="selector-section bg-gray-100">
  <div class="container selector-container">
    <div class="selector-header text-center">
      <h2 class="section-title">O que você precisa identificar?</h2>
      <p class="section-subtitle">
        Selecione uma opção abaixo para encontrar a solução ideal para o seu projeto.
      </p>
    </div>

    <div class="selector-grid">
      <a href="/produtos/etiquetas-de-patrimonio" class="selector-card">
        <div class="selector-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M4 4h16v16H4z"></path><path d="M4 10h16"></path><path d="M10 4v16"
            ></path></svg
          >
        </div>
        <span class="selector-label">Patrimônio</span>
      </a>

      <a href="/produtos/placas-para-maquinas" class="selector-card">
        <div class="selector-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
            ></path></svg
          >
        </div>
        <span class="selector-label">Máquina</span>
      </a>

      <a href="/produtos/placas-de-sinalizacao" class="selector-card">
        <div class="selector-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M3 12h18"></path><path d="m12 3 9 9-9 9"></path></svg
          >
        </div>
        <span class="selector-label">Ambiente</span>
      </a>

      <a href="/produtos/etiquetas-metalicas" class="selector-card">
        <div class="selector-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line
              x1="3"
              y1="9"
              x2="21"
              y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg
          >
        </div>
        <span class="selector-label">Produto</span>
      </a>

      <a href="/produtos/painel" class="selector-card">
        <div class="selector-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle
              cx="8.5"
              cy="8.5"
              r="1.5"></circle><circle cx="15.5" cy="8.5" r="1.5"></circle><circle
              cx="15.5"
              cy="15.5"
              r="1.5"></circle><circle cx="8.5" cy="15.5" r="1.5"></circle></svg
          >
        </div>
        <span class="selector-label">Painel</span>
      </a>

      <a href="/segmentos/hospitais" class="selector-card">
        <div class="selector-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg
          >
        </div>
        <span class="selector-label">Hospitalar</span>
      </a>

      <a href="/projetos" class="selector-card selector-custom">
        <div class="selector-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polygon
              points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
            ></polygon></svg
          >
        </div>
        <span class="selector-label">Projeto Personalizado</span>
      </a>
    </div>
  </div>
</section>

<style>
  .selector-section {
    padding: var(--space-16) 0;
  }

  .selector-header {
    margin-bottom: var(--space-12);
  }

  .selector-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
  }

  .selector-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    background-color: var(--color-white);
    padding: var(--space-6) var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-gray-200);
    width: 140px;
    text-align: center;
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 768px) {
    .selector-card {
      width: 160px;
    }
  }

  .selector-icon {
    color: var(--color-gray-500);
    transition: color var(--transition-fast);
  }

  .selector-label {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-graphite-800);
    line-height: 1.2;
  }

  .selector-card:hover,
  .selector-card:focus-visible {
    border-color: var(--color-primary-500);
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  .selector-card:hover .selector-icon,
  .selector-card:focus-visible .selector-icon {
    color: var(--color-primary-600);
  }

  .selector-custom {
    background-color: var(--color-graphite-900);
    border-color: var(--color-graphite-900);
  }

  .selector-custom .selector-label {
    color: var(--color-white);
  }

  .selector-custom .selector-icon {
    color: var(--color-primary-400);
  }

  .selector-custom:hover,
  .selector-custom:focus-visible {
    border-color: var(--color-graphite-900);
  }
</style>
