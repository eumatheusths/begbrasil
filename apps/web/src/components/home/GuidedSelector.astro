---
const options = [
  {
    label: 'Patrimônio',
    description: 'Controle de ativos',
    href: '/produtos/etiquetas-de-patrimonio',
    icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9v6M10 9v6M14 9v6M17 9v6"/>',
  },
  {
    label: 'Máquina',
    description: 'Dados e comandos',
    href: '/produtos/placas-para-maquinas',
    icon: '<path d="M12 2v3M12 19v3M4.9 4.9 7 7M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="2"/>',
  },
  {
    label: 'Ambiente',
    description: 'Orientação e segurança',
    href: '/produtos/placas-de-sinalizacao',
    icon: '<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3"/><path d="M1 14h6M9 8h6M17 16h6"/>',
  },
  {
    label: 'Produto',
    description: 'Marca e identificação',
    href: '/produtos',
    icon: '<path d="M20.6 13.6 11 23l-9-9V4h10l8.6 8.6a1.4 1.4 0 0 1 0 2Z"/><circle cx="7" cy="9" r="1.5"/>',
  },
  {
    label: 'Painel',
    description: 'Escalas e instruções',
    href: '/produtos/placas-para-maquinas',
    icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 8h10M7 12h4M7 16h7"/><circle cx="17" cy="15.5" r="1.5"/>',
  },
  {
    label: 'Hospitalar',
    description: 'Uso técnico e clínico',
    href: '/segmentos',
    icon: '<path d="M9 3h6v5h5v6h-5v5H9v-5H4V8h5V3Z"/>',
  },
  {
    label: 'Projeto personalizado',
    description: 'Feito para sua necessidade',
    href: '/orcamento',
    icon: '<path d="m12 2 2.4 6.1L21 9l-5 4.3 1.5 6.5L12 16.4l-5.5 3.4L8 13.3 3 9l6.6-.9L12 2Z"/><path d="m19 18 1 1 2-2"/>',
  },
];
---

<section id="seletor" class="selector-section">
  <div class="container selector-container">
    <div class="selector-header text-center">
      <span class="selector-eyebrow">Soluções por aplicação</span>
      <h2 class="section-title">O que você precisa identificar?</h2>
      <p class="section-subtitle">
        Escolha uma categoria e encontre o caminho certo para o seu projeto.
      </p>
    </div>
    <div class="selector-grid">
      {
        options.map((option) => (
          <a href={option.href} class="selector-card">
            <span class="selector-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <Fragment set:html={option.icon} />
              </svg>
            </span>
            <strong>{option.label}</strong>
            <span class="selector-description">{option.description}</span>
            <span class="selector-link" aria-hidden="true">
              Ver solução <b>→</b>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .selector-section {
    background: linear-gradient(145deg, #f8fbff, #eef7ff);
    padding: var(--space-16) 0;
  }
  .selector-header {
    margin-bottom: var(--space-10);
  }
  .selector-eyebrow {
    color: var(--color-primary-600);
    display: block;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    margin-bottom: 8px;
    text-transform: uppercase;
  }
  .selector-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }
  .selector-card {
    background: rgb(255 255 255 / 88%);
    border: 1px solid #dbeafe;
    border-radius: 18px;
    box-shadow: 0 10px 30px -24px rgb(29 78 216 / 45%);
    color: inherit;
    display: flex;
    flex-direction: column;
    min-height: 230px;
    padding: 20px 17px;
    position: relative;
    text-decoration: none;
    transition:
      border 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .selector-card::after {
    background: var(--gradient-brand);
    border-radius: 99px;
    content: '';
    height: 4px;
    inset: auto 20px 0;
    opacity: 0;
    position: absolute;
    transform: scaleX(0.55);
    transition: 0.2s ease;
  }
  .selector-card:hover,
  .selector-card:focus-visible {
    border-color: #38bdf8;
    box-shadow: 0 18px 35px -22px rgb(29 78 216 / 65%);
    transform: translateY(-6px);
  }
  .selector-card:hover::after,
  .selector-card:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }
  .selector-icon {
    align-items: center;
    background: linear-gradient(135deg, #dbeafe, #cffafe);
    border-radius: 15px;
    color: #075fd8;
    display: flex;
    height: 58px;
    justify-content: center;
    margin-bottom: 18px;
    width: 58px;
  }
  .selector-icon svg {
    height: 31px;
    width: 31px;
  }
  .selector-card strong {
    color: var(--color-graphite-900);
    font-size: 0.98rem;
    line-height: 1.25;
  }
  .selector-description {
    color: var(--color-gray-600);
    font-size: 0.82rem;
    line-height: 1.4;
    margin-top: 7px;
  }
  .selector-link {
    color: var(--color-primary-600);
    font-size: 0.78rem;
    font-weight: 700;
    margin-top: auto;
    padding-top: 18px;
  }
  .selector-link b {
    display: inline-block;
    margin-left: 3px;
    transition: transform 0.18s ease;
  }
  .selector-card:hover .selector-link b {
    transform: translateX(4px);
  }
  @media (max-width: 1100px) {
    .selector-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (max-width: 720px) {
    .selector-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .selector-card {
      min-height: 210px;
    }
  }
  @media (max-width: 420px) {
    .selector-grid {
      grid-template-columns: 1fr;
    }
    .selector-card {
      min-height: 190px;
    }
  }
</style>
