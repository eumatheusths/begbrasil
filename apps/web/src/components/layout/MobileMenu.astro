---
// MobileMenu.astro
const navItems = [
  { label: 'Soluções', href: '/solucoes' },
  {
    label: 'Produtos',
    href: '/produtos',
    dropdown: [
      { label: 'Etiquetas de Patrimônio', href: '/produtos/etiquetas-de-patrimonio' },
      { label: 'Placas para Máquinas', href: '/produtos/placas-para-maquinas' },
      { label: 'Sinalização', href: '/produtos/placas-de-sinalizacao' },
      { label: 'Placas Personalizadas', href: '/solucoes' },
    ],
  },
  { label: 'Materiais', href: '/materiais' },
  { label: 'Segmentos', href: '/segmentos' },
  { label: 'Sobre', href: '/sobre' },
  { label: 'Contato', href: '/contato' },
];
---

<div class="mobile-menu-overlay" id="mobile-menu-overlay"></div>
<div class="mobile-menu-drawer" id="mobile-menu-drawer" aria-hidden="true">
  <div class="drawer-header">
    <span class="logo-text">BEG BRASIL</span>
    <button class="close-toggle" aria-label="Fechar Menu" id="mobile-menu-close">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="drawer-body">
    <nav aria-label="Mobile Navigation">
      <ul class="mobile-nav-list">
        {
          navItems.map((item) => (
            <li class="mobile-nav-item">
              {item.dropdown ? (
                <details class="mobile-accordion">
                  <summary class="mobile-accordion-summary">
                    {item.label}
                    <svg
                      class="accordion-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </summary>
                  <ul class="mobile-sub-list">
                    <li>
                      <a href={item.href} class="mobile-sub-link font-medium">
                        Ver todos {item.label}
                      </a>
                    </li>
                    {item.dropdown.map((dropItem) => (
                      <li>
                        <a href={dropItem.href} class="mobile-sub-link">
                          {dropItem.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={item.href} class="mobile-nav-link">
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="drawer-footer">
    <a href="/orcamento" class="btn-mobile-quote">Solicitar Orçamento</a>
  </div>
</div>

<style>
  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(15, 23, 42, 0.5);
    z-index: 90;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-normal);
  }

  .mobile-menu-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 85%;
    max-width: 360px;
    background-color: var(--color-white);
    z-index: 100;
    transform: translateX(100%);
    transition: transform var(--transition-normal);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-lg);
  }

  .mobile-menu-drawer.is-active {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .logo-text {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-primary-600);
  }

  .close-toggle {
    color: var(--color-graphite-900);
    padding: var(--space-2);
    border-radius: var(--radius-sm);
  }

  .close-toggle:focus-visible {
    background-color: var(--color-gray-100);
  }

  .drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-4);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-nav-link,
  .mobile-accordion-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: var(--space-3) 0;
    font-size: var(--text-lg);
    font-weight: var(--font-medium);
    color: var(--color-graphite-900);
    border-bottom: 1px solid var(--color-gray-200);
    cursor: pointer;
  }

  details[open] .accordion-icon {
    transform: rotate(180deg);
  }

  .mobile-sub-list {
    list-style: none;
    padding-left: var(--space-4);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    background-color: var(--color-gray-100);
    border-radius: var(--radius-md);
    margin-top: var(--space-2);
  }

  .mobile-sub-link {
    display: block;
    padding: var(--space-2) 0;
    color: var(--color-graphite-800);
  }

  .font-medium {
    font-weight: var(--font-medium);
    color: var(--color-primary-600);
  }

  .drawer-footer {
    padding: var(--space-4);
    border-top: 1px solid var(--color-gray-200);
  }

  .btn-mobile-quote {
    display: block;
    width: 100%;
    text-align: center;
    background-color: var(--color-primary-600);
    color: var(--color-white);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    font-weight: var(--font-medium);
  }
</style>

<script>
  // Simple vanilla JS toggle for demonstration in design-system
  document.addEventListener('DOMContentLoaded', () => {
    const btnOpen = document.getElementById('mobile-menu-btn');
    const btnClose = document.getElementById('mobile-menu-close');
    const drawer = document.getElementById('mobile-menu-drawer');
    const overlay = document.getElementById('mobile-menu-overlay');

    if (btnOpen && btnClose && drawer && overlay) {
      btnOpen.addEventListener('click', () => {
        drawer.classList.add('is-active');
        overlay.classList.add('is-active');
        drawer.setAttribute('aria-hidden', 'false');
      });

      const closeMenu = () => {
        drawer.classList.remove('is-active');
        overlay.classList.remove('is-active');
        drawer.setAttribute('aria-hidden', 'true');
      };

      btnClose.addEventListener('click', closeMenu);
      overlay.addEventListener('click', closeMenu);
    }
  });
</script>
