---
// ArticleCard.astro
export interface Props {
  title: string;
  summary: string;
  imageUrl: string;
  href: string;
  date: string;
  category: string;
}

const { title, summary, imageUrl, href, date, category } = Astro.props;
---

<a href={href} class="article-card">
  <div class="article-image">
    <img src={imageUrl} alt={title} loading="lazy" width="400" height="250" />
  </div>
  <div class="article-content">
    <div class="article-meta">
      <span class="article-category">{category}</span>
      <span class="article-date">{date}</span>
    </div>
    <h3 class="article-title">{title}</h3>
    <p class="article-summary">{summary}</p>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    border: 1px solid var(--color-gray-200);
    transition: all var(--transition-normal);
    height: 100%;
  }

  .article-card:hover,
  .article-card:focus-visible {
    box-shadow: var(--shadow-md);
    border-color: var(--color-gray-300);
    transform: translateY(-2px);
  }

  .article-image {
    aspect-ratio: 16/9;
    overflow: hidden;
    background-color: var(--color-gray-100);
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .article-card:hover .article-image img {
    transform: scale(1.05);
  }

  .article-content {
    padding: var(--space-4) var(--space-6) var(--space-6) var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .article-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
  }

  .article-category {
    color: var(--color-primary-600);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-date {
    color: var(--color-graphite-500);
  }

  .article-title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-graphite-900);
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }

  .article-card:hover .article-title {
    color: var(--color-primary-600);
  }

  .article-summary {
    color: var(--color-graphite-500);
    font-size: var(--text-sm);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
