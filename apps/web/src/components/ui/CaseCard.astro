---
// CaseCard.astro
export interface Props {
  clientName?: string;
  client?: string;
  title: string;
  description?: string;
  imageUrl: string;
  href: string;
  linkLabel?: string;
}

const {
  clientName,
  title,
  description,
  imageUrl,
  href,
  linkLabel = 'Ver solução completa',
} = Astro.props;
---

<a href={href} class="case-card">
  <div class="case-image">
    <img src={imageUrl} alt={title} loading="lazy" />
    {clientName && <div class="case-client-badge">{clientName}</div>}
  </div>
  <div class="case-content">
    <h3 class="case-title">{title}</h3>
    <p class="case-description">{description}</p>
    <span class="case-link">{linkLabel} &rarr;</span>
  </div>
</a>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    border: 1px solid var(--color-gray-200);
    transition: all var(--transition-normal);
    height: 100%;
  }

  .case-card:hover,
  .case-card:focus-visible {
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary-500);
    transform: translateY(-4px);
  }

  .case-image {
    position: relative;
    aspect-ratio: 16/9;
    background-color: var(--color-graphite-900);
    overflow: hidden;
  }

  .case-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.94;
    transition:
      opacity var(--transition-normal),
      transform var(--transition-slow);
  }

  .case-card:hover .case-image img {
    opacity: 1;
    transform: scale(1.05);
  }

  .case-client-badge {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    background-color: var(--color-white);
    color: var(--color-graphite-900);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .case-content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .case-title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-graphite-900);
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }

  .case-description {
    color: var(--color-graphite-500);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .case-link {
    color: var(--color-primary-600);
    font-weight: var(--font-semibold);
    font-size: var(--text-sm);
    margin-top: auto;
  }
</style>
