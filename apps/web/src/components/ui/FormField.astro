---
// FormField.astro
export interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  placeholder?: string;
  required?: boolean;
  options?: { value: string; label: string }[];
  error?: string;
  hint?: string;
  disabled?: boolean;
}

const {
  label,
  name,
  type = 'text',
  placeholder,
  required = false,
  options = [],
  error,
  hint,
  disabled = false,
} = Astro.props;

const id = `field-${name}`;
---

<div class={`form-field ${error ? 'has-error' : ''} ${disabled ? 'is-disabled' : ''}`}>
  <label for={id} class="field-label">
    {label}
    {
      required && (
        <span class="required-mark" aria-hidden="true">
          *
        </span>
      )
    }
  </label>

  <div class="field-control">
    {
      type === 'textarea' ? (
        <textarea
          id={id}
          name={name}
          placeholder={placeholder}
          required={required}
          disabled={disabled}
          class="input-element textarea-element"
          rows="4"
          aria-invalid={error ? 'true' : 'false'}
          aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined}
        />
      ) : type === 'select' ? (
        <div class="select-wrapper">
          <select
            id={id}
            name={name}
            required={required}
            disabled={disabled}
            class="input-element select-element"
            aria-invalid={error ? 'true' : 'false'}
            aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined}
          >
            {placeholder && (
              <option value="" disabled selected>
                {placeholder}
              </option>
            )}
            {options.map((opt) => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
          <svg
            class="select-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </div>
      ) : (
        <input
          type={type}
          id={id}
          name={name}
          placeholder={placeholder}
          required={required}
          disabled={disabled}
          class="input-element"
          aria-invalid={error ? 'true' : 'false'}
          aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined}
        />
      )
    }
  </div>

  {
    error && (
      <div id={`${id}-error`} class="field-error" aria-live="polite">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        {error}
      </div>
    )
  }

  {
    hint && !error && (
      <div id={`${id}-hint`} class="field-hint">
        {hint}
      </div>
    )
  }
</div>

<style>
  .form-field {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-4);
  }

  .field-label {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-graphite-900);
    margin-bottom: var(--space-2);
    display: inline-block;
  }

  .required-mark {
    color: var(--color-error);
    margin-left: 2px;
  }

  .field-control {
    position: relative;
  }

  .input-element {
    width: 100%;
    padding: var(--space-3);
    font-family: var(--font-primary);
    font-size: var(--text-base);
    color: var(--color-graphite-900);
    background-color: var(--color-white);
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    min-height: 50px;
    transition: all var(--transition-fast);
    appearance: none;
  }

  .input-element::placeholder {
    color: var(--color-graphite-500);
  }

  .input-element:hover:not(:disabled) {
    border-color: var(--color-graphite-500);
  }

  .input-element:focus {
    outline: none;
    border-color: var(--color-primary-500);
    box-shadow: 0 0 0 4px rgb(37 99 235 / 14%);
  }

  .textarea-element {
    resize: vertical;
    min-height: 100px;
  }

  .select-wrapper {
    position: relative;
  }

  .select-icon {
    position: absolute;
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-graphite-500);
  }

  .has-error .input-element {
    border-color: var(--color-error);
  }

  .has-error .input-element:focus {
    box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.1);
  }

  .is-disabled .field-label {
    color: var(--color-graphite-500);
  }

  .is-disabled .input-element {
    background-color: var(--color-gray-100);
    color: var(--color-graphite-500);
    cursor: not-allowed;
    border-color: var(--color-gray-200);
  }

  .field-error {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-error);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    margin-top: var(--space-2);
  }

  .field-hint {
    color: var(--color-graphite-500);
    font-size: var(--text-xs);
    margin-top: var(--space-2);
  }
</style>
