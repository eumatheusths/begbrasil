---
// Hero.astro
export interface Props {
  title: string;
  subtitle: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  imageUrl?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, primaryCta, secondaryCta, imageUrl, align = 'left' } = Astro.props;
---

<section class={`hero-section ${align === 'center' ? 'hero-center' : ''}`}>
  <div class="container hero-container">
    <div class="hero-content">
      <h1 class="hero-title">{title}</h1>
      <p class="hero-subtitle">{subtitle}</p>

      <div class="hero-actions">
        {
          primaryCta && (
            <a href={primaryCta.href} class="btn btn-primary">
              {primaryCta.label}
            </a>
          )
        }
        {
          secondaryCta && (
            <a href={secondaryCta.href} class="btn btn-outline">
              {secondaryCta.label}
            </a>
          )
        }
      </div>
    </div>

    {
      imageUrl && (
        <div class="hero-media">
          <div class="hero-image-wrapper">
            <img
              src={imageUrl}
              alt=""
              aria-hidden="true"
              class="hero-image"
              loading="eager"
              fetchpriority="high"
              width="800"
              height="600"
            />
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero-section {
    background: var(--gradient-hero);
    padding: var(--space-12) 0;
    position: relative;
    overflow: hidden;
  }

  .hero-section::before,
  .hero-section::after {
    border-radius: 999px;
    content: '';
    pointer-events: none;
    position: absolute;
  }

  .hero-section::before {
    background: rgb(56 189 248 / 18%);
    height: 320px;
    right: -120px;
    top: -180px;
    width: 320px;
  }

  .hero-section::after {
    background: rgb(251 191 36 / 14%);
    bottom: -160px;
    height: 280px;
    left: -120px;
    width: 280px;
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding: var(--space-16) 0 var(--space-24) 0;
    }
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .hero-container {
      flex-direction: row;
      align-items: center;
    }

    .hero-center .hero-container {
      flex-direction: column;
      text-align: center;
    }
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero-center .hero-content {
    align-items: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--color-graphite-900);
    line-height: 1.1;
    letter-spacing: -0.025em;
    position: relative;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: var(--text-4xl);
    }
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-graphite-500);
    max-width: 600px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-weight: var(--font-medium);
    font-size: var(--text-base);
    transition: all var(--transition-fast);
    text-decoration: none;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--gradient-brand);
    color: var(--color-white);
    border: 2px solid transparent;
    box-shadow: var(--shadow-color);
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    filter: saturate(1.2) brightness(0.95);
    transform: translateY(-2px);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--color-graphite-900);
    border: 2px solid var(--color-gray-200);
  }

  .btn-outline:hover,
  .btn-outline:focus-visible {
    border-color: var(--color-graphite-900);
    background-color: var(--color-gray-100);
  }

  .hero-media {
    flex: 1;
    position: relative;
  }

  .hero-image-wrapper {
    position: relative;
    border: 6px solid rgb(255 255 255 / 85%);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 24px 60px -24px rgb(29 78 216 / 55%);
    background-color: var(--color-gray-200);
    aspect-ratio: 4/3;
  }

  .hero-image-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    pointer-events: none;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
