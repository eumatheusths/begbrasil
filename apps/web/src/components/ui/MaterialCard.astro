---
// MaterialCard.astro
export interface Props {
  name: string;
  description: string;
  features: string[];
  href: string;
}

const { name, description, features, href } = Astro.props;
---

<div class="material-card">
  <div class="card-header">
    <h3 class="material-name">{name}</h3>
    <p class="material-desc">{description}</p>
  </div>

  <div class="card-body">
    <ul class="feature-list">
      {
        features.map((feature) => (
          <li>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
            {feature}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="card-footer">
    <a href={href} class="btn-secondary">Detalhes Técnicos</a>
  </div>
</div>

<style>
  .material-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    height: 100%;
    transition: box-shadow var(--transition-normal);
  }

  .material-card:hover {
    box-shadow: var(--shadow-md);
  }

  .card-header {
    margin-bottom: var(--space-6);
  }

  .material-name {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-graphite-900);
    margin-bottom: var(--space-2);
  }

  .material-desc {
    color: var(--color-graphite-500);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .card-body {
    flex: 1;
    margin-bottom: var(--space-6);
  }

  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-graphite-800);
  }

  .feature-list svg {
    color: var(--color-primary-600);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .btn-secondary {
    display: block;
    width: 100%;
    text-align: center;
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-gray-100);
    color: var(--color-graphite-900);
    font-weight: var(--font-medium);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-secondary:hover,
  .btn-secondary:focus-visible {
    background-color: var(--color-gray-200);
    color: var(--color-primary-700);
  }
</style>
