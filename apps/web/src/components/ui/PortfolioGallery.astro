const categories = ['Todos', ...new Set(projects.map((project) => project.category))];
---

<section class="portfolio-section" aria-labelledby="portfolio-title">
  <div class="container">
    <div class="portfolio-heading">
      <span>Produção BEG Brasil</span>
      <h2 id="portfolio-title">Projetos que saíram do papel</h2>
      <p>
        Uma amostra de etiquetas, placas, escalas, painéis e peças especiais desenvolvidas sob
        medida.
      </p>
    </div>

    <div class="portfolio-filters" aria-label="Filtrar projetos por categoria">
      {
        categories.map((category, index) => (
          <button
            type="button"
            class:list={['filter-button', index === 0 ? 'active' : '']}
            data-filter={category}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {category}
          </button>
        ))
      }
    </div>

    <div class="portfolio-grid">
      {
        projects.map((project, index) => (
          <figure
            class:list={['portfolio-item', index === 0 || index === 9 ? 'featured' : '']}
            data-category={project.category}
          >
            <img src={project.src} alt={project.alt} loading="lazy" width="700" height="700" />
            <figcaption>
              <span>{project.category}</span>
              <p>{project.alt}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
  const portfolioItems = document.querySelectorAll<HTMLElement>('.portfolio-item');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedCategory = button.dataset.filter;

      filterButtons.forEach((item) => {
        const isActive = item === button;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });

      portfolioItems.forEach((item) => {
        item.hidden = selectedCategory !== 'Todos' && item.dataset.category !== selectedCategory;
      });
    });
  });
</script>

<style>
  .portfolio-section {
    background:
      radial-gradient(circle at 90% 5%, rgb(251 191 36 / 20%), transparent 24rem),
      linear-gradient(180deg, var(--color-sky-50) 0%, #fff7ed 100%);
    padding: var(--space-16) 0;
  }

  .portfolio-heading {
    margin-bottom: var(--space-12);
    max-width: 680px;
  }

  .portfolio-heading > span {
    color: var(--color-primary-600);
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
    text-transform: uppercase;
  }

  .portfolio-heading h2 {
    color: var(--color-graphite-900);
    font-size: var(--text-3xl);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .portfolio-heading p {
    color: var(--color-graphite-500);
    font-size: var(--text-lg);
    line-height: 1.65;
  }

  .portfolio-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  .portfolio-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .filter-button {
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    color: var(--color-graphite-800);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    padding: var(--space-2) var(--space-4);
    transition: all var(--transition-fast);
  }

  .filter-button:hover,
  .filter-button.active {
    background: var(--gradient-brand);
    border-color: transparent;
    color: var(--color-white);
    box-shadow: var(--shadow-color);
  }

  .portfolio-item {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    margin: 0;
    overflow: hidden;
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .portfolio-item:hover {
    box-shadow: var(--shadow-color);
    transform: translateY(-4px);
  }

  .portfolio-item[hidden] {
    display: none;
  }

  .portfolio-item img {
    aspect-ratio: 4 / 3;
    height: auto;
    object-fit: cover;
    transition: transform var(--transition-slow);
    width: 100%;
  }

  .portfolio-item:hover img {
    transform: scale(1.03);
  }

  .portfolio-item figcaption {
    padding: var(--space-4);
  }

  .portfolio-item figcaption span {
    background: var(--gradient-brand);
    background-clip: text;
    color: transparent;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
  }

  .portfolio-item figcaption p {
    color: var(--color-graphite-800);
    font-size: var(--text-sm);
    margin-top: var(--space-2);
  }

  @media (min-width: 640px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .portfolio-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .portfolio-item.featured {
      grid-column: span 2;
    }
  }
</style>
