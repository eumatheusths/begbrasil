---
// QuoteCTA.astro
export interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  href?: string;
}

const {
  title = 'Precisa de uma solução específica em identificação?',
  description = 'Envie os detalhes do seu projeto ou as especificações do ambiente industrial. Nossos especialistas responderão com um orçamento rápido e técnico.',
  buttonText = 'Solicitar Orçamento',
  href = '/orcamento',
} = Astro.props;
---

<section class="quote-cta">
  <div class="container cta-container">
    <div class="cta-content">
      <h2 class="cta-title">{title}</h2>
      <p class="cta-desc">{description}</p>
    </div>
    <div class="cta-action">
      <a href={href} class="btn-primary-large">{buttonText}</a>
    </div>
  </div>
</section>

<style>
  .quote-cta {
    background: var(--gradient-brand);
    padding: var(--space-12) 0;
    color: var(--color-white);
    overflow: hidden;
    position: relative;
  }

  .quote-cta::after {
    background: rgb(251 191 36 / 22%);
    border-radius: 999px;
    content: '';
    height: 280px;
    position: absolute;
    right: -100px;
    top: -150px;
    width: 280px;
  }

  .cta-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .cta-container {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .cta-content {
    flex: 1;
    max-width: 700px;
  }

  .cta-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .cta-title {
      font-size: var(--text-3xl);
    }
  }

  .cta-desc {
    color: var(--color-gray-200);
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .cta-action {
    flex-shrink: 0;
  }

  .btn-primary-large {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4) var(--space-8);
    background-color: var(--color-white);
    color: var(--color-primary-700);
    font-weight: var(--font-bold);
    font-size: var(--text-lg);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
    white-space: nowrap;
    box-shadow: var(--shadow-color);
  }

  .btn-primary-large:hover,
  .btn-primary-large:focus-visible {
    background-color: var(--color-gray-100);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
</style>
