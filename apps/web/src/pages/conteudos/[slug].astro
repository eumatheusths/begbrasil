---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import JsonLd from '../../components/seo/JsonLd.astro';

export async function getStaticPaths() {
  const articles = await getCollection('artigos');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const formatClusterName = (name: string) => {
  const map: Record<string, string> = {
    patrimonio: 'Patrimônio',
    maquinas: 'Máquinas Industriais',
    sinalizacao: 'Sinalização',
    marca: 'Identificação de Marca',
  };
  return map[name] || name;
};
---

<Layout
  title={article.data.title}
  description={article.data.description}
  image={article.data.image}
>
  <JsonLd
    type="Article"
    data={{
      headline: article.data.title,
      description: article.data.description,
      author: {
        '@type': 'Person',
        name: article.data.author,
      },
      datePublished: article.data.publishedAt,
      dateModified: article.data.updatedAt,
      publisher: {
        '@type': 'Organization',
        name: 'BEG Brasil',
        logo: {
          '@type': 'ImageObject',
          url: 'https://begbrasil.com.br/logo.png',
        },
      },
    }}
  />

  <JsonLd
    type="BreadcrumbList"
    data={{
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://begbrasil.com.br/' },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Conteúdos',
          item: 'https://begbrasil.com.br/conteudos',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: article.data.title,
          item: `https://begbrasil.com.br/conteudos/${article.id}`,
        },
      ],
    }}
  />

  <div class="container article-shell">
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Conteúdos', href: '/conteudos' },
        {
          label: formatClusterName(article.data.cluster),
          href: `/conteudos#${article.data.cluster}`,
        },
        { label: article.data.title, href: `/conteudos/${article.id}` },
      ]}
    />

    <div class="article-layout">
      <!-- Article Content -->
      <main class="article-main">
        <header class="article-header">
          {
            article.data.image && (
              <img
                class="article-hero"
                src={article.data.image}
                alt={article.data.title}
                width="1200"
                height="675"
                fetchpriority="high"
              />
            )
          }
          <div class="article-meta">
            <span class="bg-primary-50 text-primary-700 px-3 py-1 rounded-full font-medium">
              {formatClusterName(article.data.cluster)}
            </span>
            <span>{new Date(article.data.publishedAt).toLocaleDateString('pt-BR')}</span>
          </div>
          <h1 class="article-title">
            {article.data.title}
          </h1>

          <div class="author-row">
            <div class="flex items-center">
              <div
                class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center text-gray-500 mr-3"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  ></path></svg
                >
              </div>
              <div>
                <p class="text-sm font-bold text-gray-900">{article.data.author}</p>
                {
                  article.data.reviewer && (
                    <p class="text-xs text-gray-500">Revisão: {article.data.reviewer}</p>
                  )
                }
              </div>
            </div>
          </div>
        </header>

        <article class="prose prose-lg prose-primary max-w-none">
          <Content />
        </article>
      </main>

      <!-- Sidebar -->
      <aside class="article-aside">
        <div class="article-cta">
          <h3 class="text-xl font-bold mb-4 text-graphite-900">
            Precisa de uma solução específica?
          </h3>
          <p class="text-gray-600 mb-6 text-sm">
            Nossos engenheiros podem ajudar a definir o melhor material e fixação para o seu
            ambiente industrial.
          </p>
          <a
            href="/orcamento"
            class="block w-full bg-primary-600 hover:bg-primary-700 text-white text-center font-bold py-3 px-4 rounded transition-colors"
          >
            Solicitar Orçamento
          </a>

          <div class="mt-6 pt-6 border-t border-gray-200">
            <p class="text-sm font-medium text-gray-900 mb-2">Fale conosco pelo WhatsApp</p>
            <a
              href="https://wa.me/5511932815618"
              target="_blank"
              class="flex items-center text-green-600 hover:text-green-700 text-sm font-bold"
            >
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path></svg
              >
              (11) 93281-5618
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style is:global>
  .article-shell {
    padding-bottom: var(--space-16);
    padding-top: var(--space-8);
  }
  .article-layout {
    align-items: start;
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    grid-template-columns: minmax(0, 2fr) minmax(260px, 0.85fr);
    margin-top: var(--space-8);
  }
  .article-header {
    border-bottom: 1px solid var(--color-gray-200);
    margin-bottom: 40px;
    padding-bottom: 32px;
  }
  .article-meta {
    align-items: center;
    color: var(--color-gray-500);
    display: flex;
    font-size: var(--text-sm);
    gap: 16px;
    margin-bottom: 18px;
  }
  .article-title {
    color: var(--color-graphite-900);
    font-size: clamp(2rem, 4vw, 3.4rem);
    letter-spacing: -0.045em;
    line-height: 1.06;
    margin-bottom: 24px;
  }
  .author-row {
    align-items: center;
    display: flex;
    gap: 24px;
  }
  .article-aside {
    position: sticky;
    top: 145px;
  }
  .article-cta {
    background: linear-gradient(145deg, #f8fbff, #eef7ff);
    border: 1px solid #bfdbfe;
    border-radius: 18px;
    padding: 26px;
  }
  .article-cta h3 {
    color: var(--color-graphite-900);
    font-size: 1.25rem;
    line-height: 1.25;
    margin-bottom: 14px;
  }
  .article-cta > p {
    color: var(--color-gray-600);
    font-size: 0.925rem;
    line-height: 1.6;
    margin-bottom: 22px;
  }
  .article-cta > a[href='/orcamento'] {
    background: var(--gradient-brand);
    border-radius: 10px;
    color: white;
    display: block;
    font-weight: 700;
    padding: 12px 16px;
    text-align: center;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }
  .article-cta > a[href='/orcamento']:hover {
    box-shadow: 0 12px 24px -14px rgb(0 76 184 / 75%);
    transform: translateY(-2px);
  }
  .article-cta > div {
    border-top: 1px solid var(--color-gray-200);
    margin-top: 24px;
    padding-top: 24px;
  }
  .article-cta > div p {
    color: var(--color-graphite-900);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .article-cta a[href^='https://wa.me'] {
    align-items: center;
    color: #15803d;
    display: flex;
    font-size: 0.9rem;
    font-weight: 700;
    gap: 8px;
  }
  .article-cta svg {
    flex: none;
    height: 20px;
    width: 20px;
  }
  .article-hero {
    aspect-ratio: 16/9;
    border-radius: 20px;
    box-shadow: 0 24px 55px -35px rgb(15 23 42 / 55%);
    height: auto;
    margin-bottom: 2rem;
    object-fit: cover;
    width: 100%;
  }
  .prose h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-graphite-900);
  }
  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
    color: var(--color-graphite-800);
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose hr {
    margin: 2rem 0;
    border-color: var(--color-gray-200);
  }
  .prose table {
    border-collapse: collapse;
    margin: 28px 0;
    width: 100%;
  }
  .prose th,
  .prose td {
    border: 1px solid var(--color-gray-200);
    padding: 12px 14px;
    text-align: left;
  }
  .prose th {
    background: var(--color-primary-50);
    color: var(--color-primary-700);
  }
  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
    .article-aside {
      position: static;
    }
  }
</style>
