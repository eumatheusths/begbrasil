---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/ui/Hero.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

const allArticles = await getCollection('artigos');

// Group by cluster
const clusters = allArticles.reduce(
  (acc, article) => {
    const cluster = article.data.cluster || 'Geral';
    if (!acc[cluster]) {
      acc[cluster] = [];
    }
    acc[cluster].push(article);
    return acc;
  },
  {} as Record<string, typeof allArticles>
);

// Capitalize cluster name
const formatClusterName = (name: string) => {
  const map: Record<string, string> = {
    patrimonio: 'Patrimônio',
    maquinas: 'Máquinas Industriais',
    sinalizacao: 'Sinalização',
    marca: 'Identificação de Marca',
  };
  return map[name] || name;
};
---

<Layout
  title="Conteúdos B2B | BEG Brasil"
  description="Artigos técnicos, guias de engenharia e materiais educativos sobre identificação e sinalização industrial."
>
  <Hero
    title="Centro de Conhecimento Técnico"
    subtitle="Nossos especialistas compartilham guias e melhores práticas para a indústria."
  />

  <div class="container content-index">
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Conteúdos', href: '/conteudos' },
      ]}
    />

    <div class="content-clusters">
      {
        Object.entries(clusters).map(([cluster, articles]) => (
          <section class="content-cluster" id={cluster}>
            <h2>{formatClusterName(cluster)}</h2>
            <div class="content-grid">
              {articles.map((article) => (
                <a href={`/conteudos/${article.id}`} class="block group">
                  <article class="content-card bg-white rounded-lg shadow-sm border border-gray-200 h-full transition-all hover:shadow-md hover:border-primary-600">
                    {article.data.image && (
                      <img
                        class="content-card-image"
                        src={article.data.image}
                        alt={article.data.title}
                        width="640"
                        height="360"
                        loading="lazy"
                      />
                    )}
                    <div class="content-card-copy">
                      <span class="text-sm text-primary-600 font-medium mb-2 block">
                        {new Date(article.data.publishedAt).toLocaleDateString('pt-BR')}
                      </span>
                      <h3 class="text-xl font-bold text-graphite-900 group-hover:text-primary-600 transition-colors mb-3">
                        {article.data.title}
                      </h3>
                      <p class="text-gray-600 text-sm line-clamp-3">{article.data.description}</p>
                      <div class="content-reading mt-4 flex items-center text-sm text-gray-500">
                        <svg
                          class="w-4 h-4 mr-1"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                          />
                        </svg>
                        {article.data.author}
                      </div>
                      <span class="content-card-link">Ler artigo completo →</span>
                    </div>
                  </article>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .content-index {
    padding-bottom: var(--space-16);
    padding-top: var(--space-8);
  }
  .content-clusters {
    display: grid;
    gap: var(--space-16);
    margin-top: var(--space-12);
  }
  .content-cluster > h2 {
    border-bottom: 1px solid var(--color-gray-200);
    color: var(--color-graphite-900);
    font-size: var(--text-3xl);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
  }
  .content-grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .content-card {
    border-radius: 18px;
    overflow: hidden;
  }
  .content-card-image {
    aspect-ratio: 16/9;
    object-fit: cover;
    width: 100%;
  }
  .content-card-copy {
    padding: 24px;
  }
  .content-card-link {
    color: var(--color-primary-600);
    display: block;
    font-size: 0.86rem;
    font-weight: 750;
    margin-top: 18px;
  }
  .content-reading {
    align-items: center;
    color: var(--color-gray-500);
    display: flex;
    font-size: 0.875rem;
    gap: 5px;
    margin-top: 16px;
  }
  .content-reading svg {
    flex: 0 0 16px;
    height: 16px;
    width: 16px;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .content-index {
      padding-bottom: 44px;
      padding-top: 22px;
    }
    .content-clusters {
      gap: 42px;
      margin-top: 32px;
    }
    .content-cluster > h2 {
      font-size: 1.65rem;
      margin-bottom: 22px;
    }
    .content-grid {
      gap: 18px;
      grid-template-columns: 1fr;
    }
    .content-card {
      border-radius: 14px;
    }
    .content-card-copy {
      padding: 18px;
    }
  }
</style>
