---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/ui/Hero.astro';
import QuoteCTA from '../../components/ui/QuoteCTA.astro';

const materials = [
  {
    id: 'aco',
    name: 'Aço',
    use: 'Máquinas, equipamentos e áreas industriais',
    description:
      'Alta resistência mecânica para identificação permanente de bens expostos a impacto, abrasão e condições severas.',
    features: ['Durabilidade elevada', 'Boa resistência a impacto', 'Indicado para uso industrial'],
  },
  {
    id: 'aco-inox',
    name: 'Aço inox',
    use: 'Hospitais, indústria alimentícia e áreas úmidas',
    description:
      'Material indicado quando o projeto exige máxima resistência à corrosão, umidade, produtos químicos e temperatura.',
    features: ['Não enferruja', 'Resistência química', 'Uso interno e externo'],
  },
  {
    id: 'aluminio',
    name: 'Alumínio anodizado',
    use: 'Patrimônio, painéis e identificação técnica',
    description:
      'Solução leve e resistente à corrosão, com acabamento profissional e gravação de longa duração.',
    features: ['Leve e resistente', 'Não desbota facilmente', 'Acabamento sofisticado'],
  },
  {
    id: 'poliplastic',
    name: 'Poliplastic',
    use: 'Móveis, escritórios e equipamentos eletrônicos',
    description:
      'Alternativa versátil e econômica para controle de ativos em ambientes internos, com boa resistência à umidade.',
    features: ['Material leve', 'Boa aderência', 'Excelente custo-benefício'],
  },
  {
    id: 'cristal',
    name: 'Poliplastic cristal',
    use: 'Identificação interna com acabamento discreto',
    description:
      'Possui camada transparente de proteção, ajudando a preservar a impressão contra riscos e desgaste.',
    features: ['Proteção transparente', 'Boa resistência a riscos', 'Acabamento visual limpo'],
  },
  {
    id: 'texturizado',
    name: 'Poliplastic texturizado',
    use: 'Ativos sujeitos a manuseio frequente',
    description:
      'Superfície desenvolvida para oferecer boa aderência, legibilidade e resistência ao atrito do uso cotidiano.',
    features: ['Resistência ao manuseio', 'Boa fixação', 'Textura protetora'],
  },
  {
    id: 'acrilico',
    name: 'Acrílico',
    use: 'Comunicação, displays e identificação de marca',
    description:
      'Material de acabamento premium para placas, apliques e peças de comunicação visual personalizadas.',
    features: ['Ótimo acabamento', 'Diversas cores e espessuras', 'Corte personalizado'],
  },
];
---

<Layout
  title="Materiais para etiquetas e placas"
  description="Conheça os materiais utilizados pela BEG Brasil em etiquetas patrimoniais, placas industriais e projetos personalizados."
>
  <Hero
    title="O material certo para cada ambiente"
    subtitle="A durabilidade de uma identificação começa na especificação. Compare resistência, acabamento e aplicação para escolher com segurança."
    primaryCta={{ label: 'Falar com um especialista', href: '/orcamento' }}
    secondaryCta={{ label: 'Ver soluções', href: '/solucoes' }}
    imageUrl="/images/portfolio/pecas-acrilicas-coloridas.jpg"
  />

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Guia de materiais</span>
        <h2>Resistência e acabamento sob medida</h2>
        <p>
          As opções abaixo atendem desde o controle patrimonial interno até ambientes industriais
          agressivos.
        </p>
      </div>
      <div class="material-grid">
        {
          materials.map((material) => (
            <article id={material.id} class="material-card">
              <div class="material-top">
                <>
                  <h3>{material.name}</h3>
                  <span>{material.use}</span>
                </>
              </div>
              <p>{material.description}</p>
              <ul>
                {material.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section guidance">
    <div class="container guidance-grid">
      <div>
        <span class="eyebrow">Antes de escolher</span><h2>O ambiente define a especificação</h2>
      </div>
      <div class="checklist">
        <p><strong>Exposição:</strong> informe se a peça ficará ao sol, chuva, calor ou umidade.</p>
        <p>
          <strong>Contato:</strong> considere abrasão, limpeza, produtos químicos e manuseio frequente.
        </p>
        <p>
          <strong>Superfície:</strong> metal, plástico, pintura e textura influenciam o método de fixação.
        </p>
        <p>
          <strong>Informação:</strong> defina logotipo, numeração, QR Code, código de barras e cores.
        </p>
      </div>
    </div>
  </section>
  <QuoteCTA
    title="Ainda não sabe qual material escolher?"
    description="Conte onde a identificação será aplicada. Nossa equipe compara as opções e recomenda a melhor relação entre durabilidade, acabamento e investimento."
  />
</Layout>

<style>
  .section {
    background: var(--color-white);
    padding: var(--space-16) 0;
  }
  .section-heading {
    max-width: 720px;
    margin-bottom: var(--space-12);
  }
  .eyebrow {
    color: var(--color-primary-600);
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
    text-transform: uppercase;
  }
  h2 {
    font-size: var(--text-3xl);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }
  .section-heading p {
    color: var(--color-graphite-500);
    font-size: var(--text-lg);
  }
  .material-grid {
    display: grid;
    gap: var(--space-6);
  }
  .material-card {
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .material-top {
    border-bottom: 1px solid var(--color-gray-200);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
  }
  .material-top h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }
  .material-top span {
    color: var(--color-primary-600);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }
  .material-card > p {
    color: var(--color-graphite-500);
    line-height: 1.65;
  }
  .material-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin-top: var(--space-6);
  }
  .material-card li {
    background: var(--color-gray-100);
    border-radius: var(--radius-full);
    color: var(--color-graphite-800);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    padding: var(--space-2) var(--space-3);
  }
  .guidance {
    background: var(--color-gray-100);
  }
  .guidance-grid {
    display: grid;
    gap: var(--space-8);
  }
  .checklist {
    display: grid;
    gap: var(--space-4);
  }
  .checklist p {
    background: var(--color-white);
    border-radius: var(--radius-md);
    color: var(--color-graphite-500);
    line-height: 1.6;
    padding: var(--space-4);
  }
  .checklist strong {
    color: var(--color-graphite-900);
  }
  @media (min-width: 700px) {
    .material-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .guidance-grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
  @media (min-width: 1050px) {
    .material-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
