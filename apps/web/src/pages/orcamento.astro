---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/ui/Hero.astro';
import Stepper from '../components/ui/Stepper.astro';
---

<Layout
  title="Solicitar Orçamento | BEG Brasil"
  description="Preencha nosso formulário inteligente e receba uma cotação precisa para o seu projeto de identificação industrial."
>
  <Hero
    title="Solicitar Orçamento"
    subtitle="Nossa equipe de engenharia avaliará as informações e retornará com a melhor solução em materiais, formatos e processos."
  />

  <section class="quote-section">
    <div class="container quote-layout">
      <aside class="quote-aside">
        <span>Orçamento personalizado</span>
        <h2>Conte os detalhes do seu projeto</h2>
        <p>
          Quanto mais informações você enviar, mais precisa será a recomendação de material,
          acabamento e fixação.
        </p>
        <ul>
          <li>Retorno de uma equipe especializada</li>
          <li>Atendimento para todo o Brasil</li>
          <li>Seus arquivos tratados com segurança</li>
        </ul>
      </aside>
      <div class="quote-form-wrap">
        <Stepper />
      </div>
    </div>
  </section>
</Layout>

<style>
  .quote-section {
    background: linear-gradient(145deg, #eff6ff, #f8fbff 55%, #ecfeff);
    padding: var(--space-16) 0;
  }
  .quote-layout {
    align-items: start;
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    grid-template-columns: minmax(240px, 0.62fr) minmax(0, 1.7fr);
  }
  .quote-aside {
    position: sticky;
    top: 150px;
  }
  .quote-aside > span {
    color: var(--color-primary-600);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .quote-aside h2 {
    color: var(--color-graphite-900);
    font-size: clamp(1.8rem, 3vw, 2.55rem);
    letter-spacing: -0.04em;
    line-height: 1.08;
    margin: 12px 0 18px;
  }
  .quote-aside p {
    color: var(--color-gray-600);
    line-height: 1.7;
  }
  .quote-aside ul {
    display: grid;
    gap: 12px;
    list-style: none;
    margin-top: 28px;
  }
  .quote-aside li {
    color: var(--color-graphite-800);
    padding-left: 28px;
    position: relative;
  }
  .quote-aside li::before {
    align-items: center;
    background: #dbeafe;
    border-radius: 50%;
    color: var(--color-primary-700);
    content: '✓';
    display: flex;
    font-size: 0.72rem;
    font-weight: 900;
    height: 20px;
    justify-content: center;
    left: 0;
    position: absolute;
    top: 2px;
    width: 20px;
  }
  @media (max-width: 900px) {
    .quote-layout {
      grid-template-columns: 1fr;
    }
    .quote-aside {
      position: static;
    }
  }

  @media (max-width: 639px) {
    .quote-section {
      padding: 32px 0 42px;
    }
    .quote-layout {
      gap: 22px;
    }
    .quote-aside {
      background: rgb(255 255 255 / 72%);
      border: 1px solid #dbeafe;
      border-radius: 16px;
      padding: 20px;
    }
    .quote-aside h2 {
      font-size: 1.55rem;
      margin: 8px 0 12px;
    }
    .quote-aside p {
      font-size: 0.92rem;
      line-height: 1.55;
    }
    .quote-aside ul {
      gap: 8px;
      margin-top: 16px;
    }
    .quote-aside li {
      font-size: 0.86rem;
      padding-left: 25px;
    }
  }
</style>
