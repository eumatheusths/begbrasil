---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/ui/Hero.astro';
import QuoteCTA from '../../components/ui/QuoteCTA.astro';

const values = [
  {
    title: 'Qualidade',
    description: 'Cada produto entregue reflete excelência e atenção aos detalhes.',
  },
  { title: 'Inovação', description: 'Buscamos novas tecnologias, materiais e soluções criativas.' },
  {
    title: 'Comprometimento',
    description: 'Construímos relações confiáveis e trabalhamos por resultados consistentes.',
  },
  {
    title: 'Sustentabilidade',
    description: 'Adotamos práticas responsáveis e buscamos evolução contínua dos processos.',
  },
  {
    title: 'Transparência',
    description: 'Mantemos uma comunicação clara e ética em todas as relações.',
  },
];
---

<Layout
  title="Sobre a BEG Brasil"
  description="Conheça a história, a missão e os valores da BEG Brasil, especialista em etiquetas metálicas e identificação personalizada."
>
  <Hero
    title="Sua marca gravada para durar"
    subtitle="A BEG Brasil transforma materiais resistentes em identificação, controle e valor para empresas de diferentes setores."
    primaryCta={{ label: 'Falar com a BEG Brasil', href: '/orcamento' }}
    secondaryCta={{ label: 'Conhecer soluções', href: '/solucoes' }}
    imageUrl="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=1000&q=85"
  />

  <section class="section story">
    <div class="container story-grid">
      <div class="story-heading">
        <span>Quem somos</span><h2>Identidade, precisão e acabamento em cada detalhe</h2>
      </div>
      <div class="story-copy">
        <p>
          A BEG Brasil nasceu da paixão pela qualidade, pela precisão e pelo poder que um detalhe
          bem-feito tem de valorizar uma marca. Desde o início, a empresa se dedica a transformar
          materiais em soluções de identificação que comunicam confiança e profissionalismo.
        </p>
        <p>
          Com foco em inovação, durabilidade e acabamento, atendemos empresas que buscam
          diferenciação e alto padrão. Cada projeto recebe atenção individual, desde a definição do
          material até a personalização final.
        </p>
        <p>
          Ao longo de sua trajetória, a BEG Brasil construiu parcerias com indústrias e negócios de
          diversos segmentos, sempre com compromisso com a qualidade, o cumprimento de prazos e o
          atendimento próximo.
        </p>
      </div>
    </div>
  </section>

  <section class="section purpose">
    <div class="container purpose-grid">
      <article>
        <span>01</span><h3>Missão</h3><p>
          Desenvolver e fornecer soluções de identificação de alta qualidade que fortaleçam as
          marcas dos clientes, unindo tecnologia, design, resistência e excelência no atendimento.
        </p>
      </article>
      <article>
        <span>02</span><h3>Objetivo</h3><p>
          Ser referência nacional em identificação personalizada, reconhecida pela confiabilidade,
          inovação contínua e capacidade de transformar necessidades em soluções eficientes.
        </p>
      </article>
      <article>
        <span>03</span><h3>Meta</h3><p>
          Expandir continuamente nossa presença, investindo em tecnologia, processos produtivos e
          relacionamento, com compromisso com qualidade, sustentabilidade e evolução.
        </p>
      </article>
    </div>
  </section>

  <section class="section values">
    <div class="container">
      <div class="section-heading">
        <span>Nossos valores</span><h2>Princípios que orientam nosso trabalho</h2>
      </div>
      <div class="values-grid">
        {
          values.map((value) => (
            <article>
              <>
                <h3>{value.title}</h3>
                <p>{value.description}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section contact">
    <div class="container contact-grid">
      <div>
        <span class="label">Onde estamos</span><h2>Atendimento próximo, entrega nacional</h2><p>
          Segunda a sexta, das 8h às 17h.
        </p>
      </div>
      <address>
        <div>
          <strong>Endereço</strong><span
            >Rua Moacir de Almeida, 41<br />Água Rasa — São Paulo/SP<br />CEP 03179-130</span
          >
        </div>
        <div>
          <strong>Telefones</strong><a href="tel:+551126061421">(11) 2606-1421</a><a
            href="tel:+551126068820">(11) 2606-8820</a
          ><a href="tel:+551126045670">(11) 2604-5670</a>
        </div>
        <div>
          <strong>WhatsApp</strong><a href="https://wa.me/5511932815618">(11) 93281-5618</a><a
            href="https://wa.me/5511918547598">(11) 91854-7598</a
          ><a href="https://wa.me/5511916840525">(11) 91684-0525</a>
        </div>
        <div>
          <strong>E-mails</strong><a href="mailto:vendas1@begbrasil.com.br"
            >vendas1@begbrasil.com.br</a
          ><a href="mailto:vendas2@begbrasil.com.br">vendas2@begbrasil.com.br</a><a
            href="mailto:vendas3@begbrasil.com.br">vendas3@begbrasil.com.br</a
          >
        </div>
      </address>
    </div>
  </section>

  <QuoteCTA
    title="Vamos desenvolver seu próximo projeto?"
    description="Conte o que precisa identificar e receba orientação sobre material, formato, acabamento e fixação."
  />
</Layout>

<style>
  .section {
    background: var(--color-white);
    padding: var(--space-16) 0;
  }
  .story-grid,
  .contact-grid {
    display: grid;
    gap: var(--space-8);
  }
  .story-heading span,
  .section-heading span,
  .label {
    color: var(--color-primary-600);
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
    text-transform: uppercase;
  }
  h2 {
    font-size: var(--text-3xl);
    line-height: 1.2;
  }
  .story-copy {
    display: grid;
    gap: var(--space-4);
  }
  .story-copy p {
    color: var(--color-graphite-500);
    font-size: var(--text-lg);
    line-height: 1.8;
  }
  .purpose {
    background: var(--color-graphite-900);
    color: var(--color-white);
  }
  .purpose-grid {
    display: grid;
    gap: var(--space-8);
  }
  .purpose article {
    border-top: 1px solid var(--color-graphite-500);
    padding-top: var(--space-6);
  }
  .purpose article > span {
    color: var(--color-gray-200);
    font-size: var(--text-sm);
  }
  .purpose h3 {
    font-size: var(--text-xl);
    margin: var(--space-3) 0;
  }
  .purpose p {
    color: var(--color-gray-200);
    line-height: 1.7;
  }
  .values {
    background: var(--color-gray-100);
  }
  .section-heading {
    margin-bottom: var(--space-12);
  }
  .values-grid {
    display: grid;
    gap: var(--space-4);
  }
  .values-grid article {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .values-grid h3 {
    color: var(--color-primary-600);
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
  .values-grid p {
    color: var(--color-graphite-500);
    line-height: 1.6;
  }
  .contact p {
    color: var(--color-graphite-500);
    font-size: var(--text-lg);
    margin-top: var(--space-4);
  }
  address {
    display: grid;
    font-style: normal;
    gap: var(--space-6);
  }
  address div {
    border-bottom: 1px solid var(--color-gray-200);
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-6);
  }
  address strong {
    color: var(--color-graphite-900);
  }
  address span,
  address a {
    color: var(--color-graphite-500);
    line-height: 1.6;
  }
  address a:hover {
    color: var(--color-primary-600);
  }
  @media (min-width: 760px) {
    .story-grid,
    .contact-grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
    .purpose-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .values-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    address {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
